# GEMINI_API_KEY: Required if optional AI extensions are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by runtime.
APP_URL="MY_APP_URL"

# EventHub Runtime Mode: "local" (Local Demo Mode) or "aws" (AWS Cloud Mode)
VITE_APP_MODE="local"

# Local Auth / Ticket Signing Secret (change in production)
EVENTHUB_JWT_SECRET="eventhub-local-dev-signing-secret-change-me"

# AWS Cloud Mode Configuration (leave blank in Local Demo Mode)
VITE_API_GATEWAY_URL=""
VITE_COGNITO_USER_POOL_ID=""
VITE_COGNITO_CLIENT_ID=""
VITE_COGNITO_REGION="us-east-1"
VITE_S3_ASSETS_CDN_URL=""

# Python AWS Lambda / DynamoDB Backend Environment Variables
AWS_REGION="us-east-1"
DYNAMODB_TABLE_PREFIX="eventhub"
COGNITO_USER_POOL_ID=""
COGNITO_CLIENT_ID=""
S3_BUCKET_NAME=""
CLOUDFRONT_DOMAIN=""
TICKET_SIGNING_SECRET=""
